{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentFlow workflow 0.1",
  "type": "object",
  "required": ["schemaVersion", "workflowId", "revision", "nodes", "edges", "layout"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "workflowId": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "typeId", "version", "config"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "typeId": { "$ref": "#/$defs/id" },
          "version": { "type": "integer", "minimum": 1 },
          "config": {
            "type": "object",
            "properties": {
              "text": { "type": ["string", "null"] },
              "ports": { "type": "integer", "minimum": 0, "maximum": 16 },
              "parameters": { "type": ["object", "null"] }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "sourcePort", "target", "targetPort", "kind"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "$ref": "#/$defs/id" },
          "sourcePort": { "$ref": "#/$defs/id" },
          "target": { "$ref": "#/$defs/id" },
          "targetPort": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["message", "resource"] }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "collapsed": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "width": { "type": "number", "minimum": 223, "maximum": 1600 },
          "height": { "type": "number", "minimum": 130, "maximum": 1200 },
          "mode": { "enum": ["bypass", "disabled", null] }
        }
      }
    },
    "limits": {
      "type": ["object", "null"],
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "maxModelOutputTokens": { "type": ["integer", "null"], "minimum": 1, "maximum": 100000 }
      }
    },
    "subworkflows": { "type": ["array", "null"], "items": { "$ref": "#" } },
    "groups": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["id", "nodes"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "type": ["string", "null"] },
          "nodes": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  },
  "$defs": { "id": { "type": "string", "minLength": 1 } }
}
